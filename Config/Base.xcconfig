// Shared build settings for every configuration.
//
// Signing: by default the app is signed "to run locally" (ad-hoc), which works but makes
// macOS forget the Accessibility permission after each rebuild. To sign with your Apple ID
// instead, copy Local.xcconfig.example to Local.xcconfig (it's gitignored) and fill in your
// team ID.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
